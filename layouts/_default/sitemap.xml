{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{ range .Data.Pages }}
  {{- if and .Permalink (eq .Language.Lang $.Site.Language.Lang) -}}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{ if not .Lastmod.IsZero }}<lastmod>{{ safeHTML ( .Lastmod.Format "2006-01-02T15:04:05-07:00" ) }}</lastmod>{{ end }}
    {{ if .IsTranslated -}}
    {{- $caURL := .Permalink -}}
    {{- $enURL := "" -}}
    {{- range .Translations -}}
      {{- if eq .Language.Lang "en" -}}{{- $enURL = .Permalink -}}{{- end -}}
      {{- if eq .Language.Lang "ca" -}}{{- $caURL = .Permalink -}}{{- end -}}
    {{- end -}}
    <xhtml:link rel="alternate" hreflang="{{ .Language.Lang }}" href="{{ .Permalink }}"/>
    {{ range .Translations -}}
    <xhtml:link rel="alternate" hreflang="{{ .Language.Lang }}" href="{{ .Permalink }}"/>
    {{ end -}}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ $caURL }}"/>
    {{ end }}
  </url>
  {{- end -}}
  {{ end }}
</urlset>
